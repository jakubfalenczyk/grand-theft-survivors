    "mono": "'Martian Mono', ui-monospace, monospace",
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Barlow+Semi+Condensed:wght@500;600&family=Martian+Mono:wght@400;700&display=swap"
