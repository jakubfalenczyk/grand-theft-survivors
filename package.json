{
  "name": "grand-theft-survivors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run theme:check",
    "build": "vite build",
    "preview": "vite preview",
    "theme:build": "node scripts/theme.mjs",
    "theme:check": "node scripts/theme.mjs --check && node scripts/check-theme-usage.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run theme:check && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "test:pages": "playwright test --config playwright.pages.config.js"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@9.2.0",
  "license": "MIT"
}
